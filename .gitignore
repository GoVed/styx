# Rust build artifacts
/target
**/*.rs.bk

# Database & Runtime Data
/data
styx.db
*.db
*.db-shm
*.db-wal

# Frontend build & dependencies
ui/node_modules
ui/dist
ui/.vite
ui/coverage

# Environment & Secrets
.env
.env.*
!.env.example

# Python
*.pyc
__pycache__

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Operator Personal Memories (Contacts, Groups, Slang, Projects, Scratchpad)
# These are dynamically generated by Styx during conversation and should remain private
memory/people/
memory/groups/
memory/dictionary/
memory/projects/
memory/media/
memory/scratchpad/*
!memory/scratchpad/active_projects.md
!memory/scratchpad/daily_log.md
memory/core/*
!memory/core/system_instructions.md
!memory/core/user_profile.md

# Runtime-installed tool skillsets (auto-ingested by Styx at runtime when tools connect)
memory/skills/*.md
!memory/skills/.gitkeep

