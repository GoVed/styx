# Syndae Agent OS Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Network & Server Host
SYNDAE_HOST=0.0.0.0
SYNDAE_PORT=3000

# Access Key / Master Authentication Token
SYNDAE_ACCESS_KEY=syndae-local-dev-key

# Allowed CORS / WebSocket Origins (comma-separated)
SYNDAE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Path to Local GGUF / SafeTensors Models Directory
HOST_LOCAL_MODELS_DIR=${HOME}/localLLM/models

# Path to Syndae MCP Tools Directory (default sibling directory: ../syndae_tools)
SYNDAE_TOOLS_DIR=../syndae_tools
