# Styx Agent OS Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Network & Server Host
STYX_HOST=0.0.0.0
STYX_PORT=3000

# Access Key / Master Authentication Token
STYX_ACCESS_KEY=styx-local-dev-key

# Allowed CORS / WebSocket Origins (comma-separated)
STYX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Path to Local GGUF / SafeTensors Models Directory
HOST_LOCAL_MODELS_DIR=${HOME}/localLLM/models

# Path to Styx MCP Tools Directory (default sibling directory: ../styx_tools)
STYX_TOOLS_DIR=../styx_tools
